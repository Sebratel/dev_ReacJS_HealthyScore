# ─────────────────────────────────────────────────────────────
# Template de variáveis de ambiente. Copie para `.env` e preencha.
# O `.env` real é ignorado pelo git (contém segredos).
# ─────────────────────────────────────────────────────────────

# ── Frontend (build do Vite) ──────────────────────────────────
# Client ID público do Google OAuth. É a ÚNICA variável necessária
# para BUILD/deploy da aplicação web (Dockerfile / docker-compose).
# No Portainer, defina-a nas Environment variables da stack.
VITE_GOOGLE_CLIENT_ID=

# Porta exposta no host pelo container web (opcional, padrão 8080).
WEB_PORT=8080

# ─────────────────────────────────────────────────────────────
# Backend de queries (server/index.mjs — serviço `api`). Serve e edita o
# catálogo de queries do ETL. O nginx do web faz proxy de /api/ para cá.
# ─────────────────────────────────────────────────────────────
# Porta interna da API (default 8787). Em dev, o Vite faz proxy de /api p/ ela.
API_PORT=8787
# Domínio de e-mail permitido para acessar o catálogo (Google OAuth).
ALLOWED_DOMAIN=sebratel.com.br
# Allowlist (CSV) de quem pode EDITAR queries. Vazio → qualquer conta do domínio.
# Ex.: QUERY_EDITOR_EMAILS=fulano@sebratel.com.br,beltrano@sebratel.com.br
QUERY_EDITOR_EMAILS=
# Caminho do arquivo de overrides (compartilhado entre API e ETL).
# No container é /app/data/query-overrides.json (volume ./data). Localmente,
# se vazio, usa <repo>/data/query-overrides.json.
QUERY_OVERRIDES_PATH=

# ── Controle de acesso (RBAC) ─────────────────────────────────
# Admins SEMENTE (CSV) — sempre admin, não removíveis pela tela.
ADMIN_EMAILS=
# Power users de bootstrap (CSV). O resto é gerido em Configurações.
POWER_USER_EMAILS=
# Papéis geridos pela tela e config oficial do scoring (volume ./data).
ROLES_PATH=
OFFICIAL_CONFIG_PATH=
# Snapshot materializado que a API carrega em memória (gerado pelo ETL).
SNAPSHOT_PATH=

# ─────────────────────────────────────────────────────────────
# Banco da APLICAÇÃO (MariaDB) — módulo de Planos de Ação.
# É o único banco em que o sistema ESCREVE. Fica separado do pool do ETL de
# propósito: o ETL é somente-leitura sobre bases de terceiros.
# Sem estas variáveis a API sobe normalmente e o módulo aparece indisponível.
#
#   npm run migrate         cria a base (se faltar) e aplica as migrations
#   npm run migrate:status  lista o que está pendente
# ─────────────────────────────────────────────────────────────
DB_APP_DATABASE=DB_HealthScore
# Host/porta/usuário/senha caem nas DB_MARIA_* quando não informados —
# é o mesmo servidor MariaDB, só muda a base.
DB_APP_HOST=
DB_APP_PORT=
DB_APP_USER=
DB_APP_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Provedor de IA (módulo de Planos de Ação).
#
# O caminho normal é cadastrar pela TELA (Configurações → Provedor de IA):
# a chave fica cifrada no volume e trocar de modelo não exige redeploy.
# As variáveis abaixo são só o atalho de bootstrap — quando existem e não há
# nada cadastrado na tela, valem como configuração inicial.
# ─────────────────────────────────────────────────────────────
# Chave que cifra segredos em repouso, AES-256-GCM. Gere com:
#   openssl rand -base64 48
# Sem ela, uma chave é gerada em data/.secret (funciona, mas perder o volume
# passa a significar perder o que foi cifrado). GUARDE-A: trocá-la torna
# ilegível tudo que já foi cifrado.
APP_SECRET=

# Bootstrap opcional do provedor. Uma destas define o tipo automaticamente.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Forçam o que a dedução escolheria: anthropic | openai | gemini
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_MAX_TOKENS=
AI_EFFORT=
# Tempo máximo de espera por resposta do provedor (ms, padrão 120000).
AI_TIMEOUT_MS=

# ─────────────────────────────────────────────────────────────
# As variáveis ABAIXO são usadas APENAS pelo ETL (scripts/*.mjs) que
# roda no servidor com acesso aos bancos — NÃO entram na imagem web.
# (sem prefixo VITE_ → nunca expostas no frontend)
#
# SEGURANÇA: como as queries são editáveis pela tela e rodam no ETL, use um
# usuário PostgreSQL SOMENTE-LEITURA (apenas SELECT) em DB_ELLEVEN_USER. O
# guard do backend já barra escrita/DDL, mas o usuário read-only é a garantia.
# ─────────────────────────────────────────────────────────────

# Banco ELLEVEN (PostgreSQL)
DB_ELLEVEN_HOST=
DB_ELLEVEN_DATABASE=
DB_ELLEVEN_USER=
DB_ELLEVEN_PASSWORD=
DB_ELLEVEN_PORT=

# Banco RADIUS (PostgreSQL)
DB_RADIUS_HOST=
DB_RADIUS_DATABASE=
DB_RADIUS_USER=
DB_RADIUS_PASSWORD=
DB_RADIUS_PORT=

# Banco de massivas (MariaDB)
DB_MARIA_HOST=
DB_MARIA_DATABASE=
DB_MARIA_USER=
DB_MARIA_PASSWORD=
DB_MARIA_PORT=

# Banco AutoISP (PostgreSQL) — quedas de PPPoE / status da ONU
# Opcional: sem essas variáveis o ETL roda normalmente, apenas sem o sinal de ONU.
DB_AUTOISP_HOST=
DB_AUTOISP_DATABASE=
DB_AUTOISP_USER=
DB_AUTOISP_PASSWORD=
DB_AUTOISP_PORT=

# Segredo do Google OAuth — backend apenas, NUNCA com prefixo VITE_
GOOGLE_CLIENT_SECRET=
