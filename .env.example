# ─────────────────────────────────────────────────────────────
# Template de variáveis de ambiente. Copie para `.env` e preencha.
# O `.env` real é ignorado pelo git (contém segredos).
# ─────────────────────────────────────────────────────────────

# ── Frontend (build do Vite) ──────────────────────────────────
# Client ID público do Google OAuth. É a ÚNICA variável necessária
# para BUILD/deploy da aplicação web (Dockerfile / docker-compose).
# No Portainer, defina-a nas Environment variables da stack.
VITE_GOOGLE_CLIENT_ID=

# Porta exposta no host pelo container web (opcional, padrão 8080).
WEB_PORT=8080

# ─────────────────────────────────────────────────────────────
# Backend de queries (server/index.mjs — serviço `api`). Serve e edita o
# catálogo de queries do ETL. O nginx do web faz proxy de /api/ para cá.
# ─────────────────────────────────────────────────────────────
# Porta interna da API (default 8787). Em dev, o Vite faz proxy de /api p/ ela.
API_PORT=8787
# Domínio de e-mail permitido para acessar o catálogo (Google OAuth).
ALLOWED_DOMAIN=sebratel.com.br
# Allowlist (CSV) de quem pode EDITAR queries. Vazio → qualquer conta do domínio.
# Ex.: QUERY_EDITOR_EMAILS=fulano@sebratel.com.br,beltrano@sebratel.com.br
QUERY_EDITOR_EMAILS=
# Caminho do arquivo de overrides (compartilhado entre API e ETL).
# No container é /app/data/query-overrides.json (volume ./data). Localmente,
# se vazio, usa <repo>/data/query-overrides.json.
QUERY_OVERRIDES_PATH=

# ─────────────────────────────────────────────────────────────
# As variáveis ABAIXO são usadas APENAS pelo ETL (scripts/*.mjs) que
# roda no servidor com acesso aos bancos — NÃO entram na imagem web.
# (sem prefixo VITE_ → nunca expostas no frontend)
#
# SEGURANÇA: como as queries são editáveis pela tela e rodam no ETL, use um
# usuário PostgreSQL SOMENTE-LEITURA (apenas SELECT) em DB_ELLEVEN_USER. O
# guard do backend já barra escrita/DDL, mas o usuário read-only é a garantia.
# ─────────────────────────────────────────────────────────────

# Banco ELLEVEN (PostgreSQL)
DB_ELLEVEN_HOST=
DB_ELLEVEN_DATABASE=
DB_ELLEVEN_USER=
DB_ELLEVEN_PASSWORD=
DB_ELLEVEN_PORT=

# Banco RADIUS (PostgreSQL)
DB_RADIUS_HOST=
DB_RADIUS_DATABASE=
DB_RADIUS_USER=
DB_RADIUS_PASSWORD=
DB_RADIUS_PORT=

# Banco de massivas (MariaDB)
DB_MARIA_HOST=
DB_MARIA_DATABASE=
DB_MARIA_USER=
DB_MARIA_PASSWORD=
DB_MARIA_PORT=

# Banco AutoISP (PostgreSQL) — quedas de PPPoE / status da ONU
# Opcional: sem essas variáveis o ETL roda normalmente, apenas sem o sinal de ONU.
DB_AUTOISP_HOST=
DB_AUTOISP_DATABASE=
DB_AUTOISP_USER=
DB_AUTOISP_PASSWORD=
DB_AUTOISP_PORT=

# Segredo do Google OAuth — backend apenas, NUNCA com prefixo VITE_
GOOGLE_CLIENT_SECRET=
