# ─────────────────────────────────────────────────────────────
# Template de variáveis de ambiente. Copie para `.env` e preencha.
# O `.env` real é ignorado pelo git (contém segredos).
# ─────────────────────────────────────────────────────────────

# ── Frontend (build do Vite) ──────────────────────────────────
# Client ID público do Google OAuth. É a ÚNICA variável necessária
# para BUILD/deploy da aplicação web (Dockerfile / docker-compose).
# No Portainer, defina-a nas Environment variables da stack.
VITE_GOOGLE_CLIENT_ID=

# Porta exposta no host pelo container web (opcional, padrão 8080).
WEB_PORT=8080

# ─────────────────────────────────────────────────────────────
# As variáveis ABAIXO são usadas APENAS pelo ETL (scripts/*.mjs) que
# roda no servidor com acesso aos bancos — NÃO entram na imagem web.
# (sem prefixo VITE_ → nunca expostas no frontend)
# ─────────────────────────────────────────────────────────────

# Banco ELLEVEN (PostgreSQL)
DB_ELLEVEN_HOST=
DB_ELLEVEN_DATABASE=
DB_ELLEVEN_USER=
DB_ELLEVEN_PASSWORD=
DB_ELLEVEN_PORT=

# Banco RADIUS (PostgreSQL)
DB_RADIUS_HOST=
DB_RADIUS_DATABASE=
DB_RADIUS_USER=
DB_RADIUS_PASSWORD=
DB_RADIUS_PORT=

# Banco de massivas (MariaDB)
DB_MARIA_HOST=
DB_MARIA_DATABASE=
DB_MARIA_USER=
DB_MARIA_PASSWORD=
DB_MARIA_PORT=

# Segredo do Google OAuth — backend apenas, NUNCA com prefixo VITE_
GOOGLE_CLIENT_SECRET=
