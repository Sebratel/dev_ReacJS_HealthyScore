# Dependências e artefatos (reinstalados/rebuildados dentro da imagem)
node_modules
dist

# Git e metadados
.git
.gitignore

# Segredos — NUNCA entram no contexto de build da imagem
.env
.env.*
!.env.example

# Os próprios arquivos de docker
Dockerfile
docker-compose.yml
.dockerignore

# Diversos
*.log
npm-debug.log*
.DS_Store
.vscode

# OBS: public/realClients.data não é ignorado aqui de propósito — se existir
# na máquina que builda, entra na imagem. Mas o app NÃO o consome: o front
# carrega tudo de /api/dataset/lists, e a api lê o snapshot do volume. O
# arquivo deixou de ser versionado (ver .gitignore), então num checkout limpo
# ele simplesmente não existe e nada quebra.
